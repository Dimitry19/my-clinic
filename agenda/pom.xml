<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>it.solutions.services</groupId>
        <artifactId>clinique-trinite</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>agenda</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Module agenda</name>
    <description>Gestion des agendas de la clinique</description>
    <dependencies>
        <dependency>
            <groupId>it.solutions.services</groupId>
            <artifactId>core</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>it.solutions.services</groupId>
            <artifactId>contracts</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- ─── Lombok ───────────────────────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault> <!-- 🛠️ Fixe l'erreur de valeur null par défaut -->
            </activation>
            <properties>
                <env>development</env>
                <packaging.artifact.id>agenda</packaging.artifact.id>
                <packaging.name>agenda-dev</packaging.name>
            </properties>
        </profile>
        <profile>
            <id>docker</id>
            <properties>
                <env>docker</env>
                <packaging.artifact.id>agenda</packaging.artifact.id>
                <packaging.name>agenda-docker</packaging.name>
            </properties>
        </profile>
        <profile>
            <id>demo</id>
            <properties>
                <env>demo</env>
                <packaging.artifact.id>agenda</packaging.artifact.id>
                <packaging.name>agenda-demo</packaging.name>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.sentry</groupId>
                    <artifactId>sentry-spring-boot-starter</artifactId>
                    <version>8.22.0</version>
                </dependency>
                <dependency>
                    <groupId>io.sentry</groupId>
                    <artifactId>sentry-logback</artifactId>
                    <version>8.22.0</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <env>production</env>
                <packaging.artifact.id>agenda</packaging.artifact.id>
                <packaging.name>agenda</packaging.name>
            </properties>
        </profile>
    </profiles>

    <build>
        <finalName>${packaging.artifact.id}</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
